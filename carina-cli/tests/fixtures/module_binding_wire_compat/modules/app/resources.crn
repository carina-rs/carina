let seed = mock.test.resource {
  name = "${label}-seed"
}

let consumer = mock.test.resource {
  name    = "${label}-consumer"
  comment = "${label}-updated"

  directives {
    depends_on = [seed, upstream]
  }
}

let after_ready = mock.test.resource {
  name    = "${label}-after"
  comment = consumer_ready.identifier
}
