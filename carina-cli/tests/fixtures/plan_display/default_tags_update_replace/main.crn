# Default-tag provenance on Update and Replace map-entry rows.

provider awscc {
  region = awscc.Region.ap_northeast_1

  default_tags = {
    ManagedBy = "carina"
    Team      = "x"
  }
}

let updated = awscc.ec2.Vpc {
  cidr_block = "10.0.0.0/16"
}

let replaced = awscc.ec2.Vpc {
  cidr_block = "10.2.0.0/16"
}

exports {
  updated_cidr  = updated.cidr_block
  replaced_cidr = replaced.cidr_block
}
