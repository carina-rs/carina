# Moved block with attribute removal: previous explicit-field transfer
# State has "old_vpc" with explicit fields "cidr_block" and "tags".
# After move to "new_vpc", tags are removed from the DSL.
# Plan should detect the removal (via the previous explicit fields under the new name).

provider awscc {
  region = awscc.Region.ap_northeast_1
}

moved {
  from = awscc.ec2.Vpc 'old_vpc'
  to = awscc.ec2.Vpc 'new_vpc'
}

let new_vpc = awscc.ec2.Vpc {
  cidr_block = '10.0.0.0/16'
}

awscc.ec2.Subnet {
  vpc_id     = new_vpc.vpc_id
  cidr_block = '10.0.1.0/24'
}
