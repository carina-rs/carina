  "module_argument": {
    "providers.crn": "provider mock {}\n",
    "backend.crn": "backend local { path = 'carina.state.json' }\n",
    "lets.crn": "let src = mock.test.resource { name = 'source' }\n",
    "main.crn": "let c = use { source = './child' }\nc { prefix = src.id }\n",
    "child/arguments.crn": "arguments { prefix: String }\n",
    "child/main.crn": "mock.test.resource { name_prefix = prefix }\n"
  },
  "module_field": {
