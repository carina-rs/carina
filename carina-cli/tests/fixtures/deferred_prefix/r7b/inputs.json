  "module_output": {
    "providers.crn": "provider mock {}\n",
    "backend.crn": "backend local { path = 'carina.state.json' }\n",
    "lets.crn": "let c = use { source = './child' }\nlet net = c {}\n",
    "main.crn": "mock.test.resource { name_prefix = net.missing }\n",
    "child/main.crn": "attributes { first: String = 'first' }\n"
  },
  "upstream_export": {
    "providers.crn": "provider mock {}\n",
    "backend.crn": "backend local { path = 'carina.state.json' }\n",
    "lets.crn": "let net = upstream_state { source = './upstream' }\n",
    "main.crn": "mock.test.resource { name_prefix = net.missing }\n",
    "upstream/backend.crn": "backend local { path = 'carina.state.json' }\n",
    "upstream/exports.crn": "exports { first: String = 'first' }\n",
    "upstream/carina.state.json": "{\n  \"version\": 5,\n  \"serial\": 0,\n  \"lineage\": \"r6-upstream\",\n  \"carina_version\": \"0.1.0\",\n  \"resources\": [],\n  \"exports\": {\n    \"first\": \"first\"\n  }\n}\n"
  },
  "data_source": {
    "providers.crn": "provider mock {}\n",
    "backend.crn": "backend local { path = 'carina.state.json' }\n",
    "lets.crn": "let ds = read mock.iam.Roles { name_regex = 'pattern' }\n",
    "main.crn": "mock.test.resource { name_prefix = ds.missing }\n"
  },
  "root_loop_variable": {
    "providers.crn": "provider mock {}\n",
    "backend.crn": "backend local { path = 'carina.state.json' }\n",
    "lets.crn": "let src = mock.test.resource { name = 'source' }\n",
    "main.crn": "let items = for x in src.domain_validation_options { mock.test.resource { name_prefix = \"${x}-${src.id}\" } }\n"
  }
