    "lets.crn": "let src = mock.test.resource { name = 'source' }\n",
    "main.crn": "let c = use { source = './child' }\nc { cfg = { value = src.id } }\n",
    "child/arguments.crn": "arguments { cfg: map(String) }\n",
    "child/main.crn": "mock.test.resource { name_prefix = cfg.value }\n"
