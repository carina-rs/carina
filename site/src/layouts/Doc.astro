---
import BaseLayout from '../components/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import TOC from '../components/TOC.astro';

interface Heading { depth: number; slug: string; text: string; }
interface Props {
  title: string;
  description?: string;
  headings?: Heading[];
}

const { title, description, headings = [] } = Astro.props;
const hasToc = headings.some(heading => heading.depth >= 2 && heading.depth <= 3);
---
<BaseLayout title={title} description={description} showSidebar={false} showFooter={false}>
  <div class:list={['doc-grid', { 'has-toc': hasToc }]}>
    <Sidebar />
    <article class="doc-main">
      <header class="doc-header">
        <h1>{title}</h1>
        {description && <p class="doc-lede">{description}</p>}
      </header>
      <div class="doc-body">
        <slot />
      </div>
      <Footer />
    </article>
    {hasToc && <TOC headings={headings} />}
  </div>
</BaseLayout>

<style>
  .doc-grid {
    --nav-expanded-width: 16rem;
    --nav-column-width: var(--nav-expanded-width);
    --toc-column-width: 14rem;

    display: grid;
    grid-template-columns: var(--nav-column-width) minmax(0, 1fr);
    align-items: start;
    gap: var(--space-8);
    max-width: 96rem;
    min-height: calc(100dvh - var(--topbar-height));
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .doc-grid.has-toc {
    grid-template-columns: var(--nav-column-width) minmax(0, 1fr) var(--toc-column-width);
  }

  :global(html[data-nav-collapsed]) .doc-grid {
    --nav-column-width: 2.5rem;
  }

  :global(html[data-toc-collapsed]) .doc-grid {
    --toc-column-width: 2.5rem;
  }

  .doc-main {
    min-width: 0;
    padding: var(--space-8) 0;
    overflow-wrap: break-word;
  }

  .doc-header { margin-bottom: var(--space-8); }

  .doc-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--page-title-color);
    margin: 0 0 var(--space-3);
  }

  .doc-lede {
    font-size: var(--text-lg);
    color: var(--fg3);
    margin: 0;
  }

  .doc-body {
    color: var(--page-body-color);
    line-height: var(--lh-body);
  }

  .doc-body :global(h2) {
    position: relative;
    margin-top: 4rem;
    padding-top: 1.25rem;
    margin-bottom: var(--space-4);
    font-size: 1.55rem;
    font-weight: 700;
  }

  .doc-body :global(h2::before) {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 3rem;
    height: 1px;
    background: var(--accent);
    opacity: 0.55;
  }

  .doc-body :global(h3) {
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .doc-body :global(p) { margin: 0 0 var(--space-4); }

  .doc-body :global(ul),
  .doc-body :global(ol) {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-6);
  }

  .doc-body :global(li) { margin: var(--space-1) 0; }

  .doc-body :global(pre) {
    background: var(--code-block-bg);
    border: 1px solid var(--code-block-border);
    border-radius: var(--radius);
    padding: var(--space-4);
    overflow-x: auto;
    margin: var(--space-4) 0;
  }

  .doc-body :global(code) {
    background: var(--code-inline-bg);
    color: var(--code-inline-color);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
    font-size: 0.9em;
  }

  .doc-body :global(pre code) {
    background: transparent;
    padding: 0;
    color: var(--code-block-text);
  }

  .doc-body :global(.table-scroll) {
    margin: var(--space-4) 0;
  }

  .doc-body :global(table) {
    border-collapse: collapse;
    margin: 0;
    width: 100%;
    font-size: var(--text-sm);
  }

  .doc-body :global(th),
  .doc-body :global(td) {
    border: 1px solid var(--border);
    padding: var(--space-2) var(--space-3);
    text-align: left;
  }

  .doc-body :global(th) {
    background: var(--bg-raise);
    color: var(--fg1);
    font-weight: 600;
  }

  @media (max-width: 64rem) {
    .doc-grid {
      --nav-expanded-width: 14rem;
    }

    .doc-grid,
    .doc-grid.has-toc {
      grid-template-columns: var(--nav-column-width) minmax(0, 1fr);
    }

    .doc-grid > :global(.toc) { display: none; }
  }

  @media (max-width: 48rem) {
    .doc-grid,
    .doc-grid.has-toc {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const navToggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const tocToggle = document.querySelector<HTMLButtonElement>('[data-toc-toggle]');
  const mobileNavToggle = document.querySelector<HTMLButtonElement>('[data-mobile-nav-toggle]');

  const syncDesktopToggle = (
    toggle: HTMLButtonElement | null,
    collapsed: boolean,
    showLabel: string,
    hideLabel: string,
  ) => {
    if (!toggle) return;
    toggle.setAttribute('aria-expanded', String(!collapsed));
    toggle.setAttribute('aria-label', collapsed ? showLabel : hideLabel);
  };

  const storeCollapsedState = (key: string, collapsed: boolean) => {
    try {
      window.localStorage.setItem(key, String(collapsed));
    } catch {}
  };

  const syncDesktopToggles = () => {
    syncDesktopToggle(
      navToggle,
      root.hasAttribute('data-nav-collapsed'),
      'Show navigation',
      'Hide navigation',
    );
    syncDesktopToggle(
      tocToggle,
      root.hasAttribute('data-toc-collapsed'),
      'Show on this page',
      'Hide on this page',
    );
  };

  navToggle?.addEventListener('click', () => {
    const collapsed = !root.hasAttribute('data-nav-collapsed');
    root.toggleAttribute('data-nav-collapsed', collapsed);
    storeCollapsedState('carina-doc-nav-collapsed', collapsed);
    syncDesktopToggles();
  });

  tocToggle?.addEventListener('click', () => {
    const collapsed = !root.hasAttribute('data-toc-collapsed');
    root.toggleAttribute('data-toc-collapsed', collapsed);
    storeCollapsedState('carina-doc-toc-collapsed', collapsed);
    syncDesktopToggles();
  });

  mobileNavToggle?.addEventListener('click', () => {
    const expanded = !root.hasAttribute('data-mobile-nav-open');
    root.toggleAttribute('data-mobile-nav-open', expanded);
    mobileNavToggle.setAttribute('aria-expanded', String(expanded));
    mobileNavToggle.setAttribute(
      'aria-label',
      expanded ? 'Hide navigation menu' : 'Show navigation menu',
    );
  });

  syncDesktopToggles();

  const scrollActiveSidebarLinkIntoView = () => {
    if (
      !window.matchMedia('(min-width: 48.001rem)').matches
      || root.hasAttribute('data-nav-collapsed')
    ) return;

    const sidebar = document.querySelector<HTMLElement>('.sidebar');
    const activeLink = sidebar?.querySelector<HTMLElement>('.sidebar-link[aria-current="page"]');
    if (!sidebar || !activeLink) return;

    const linkTop = activeLink.offsetTop;
    const linkBottom = linkTop + activeLink.offsetHeight;
    const visibleTop = sidebar.scrollTop;
    const visibleBottom = visibleTop + sidebar.clientHeight;

    if (linkTop < visibleTop || linkBottom > visibleBottom) {
      sidebar.scrollTop = linkTop - (sidebar.clientHeight - activeLink.offsetHeight) / 2;
    }
  };

  scrollActiveSidebarLinkIntoView();
</script>
