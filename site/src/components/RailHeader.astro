---
interface Props {
  label: string;
  side: 'start' | 'end';
  toggle: {
    controls: string;
    label: string;
    dataAttr: 'data-nav-toggle' | 'data-toc-toggle';
  };
}

const { label, side, toggle } = Astro.props;
const dataAttribute = { [toggle.dataAttr]: '' };
const dividerPath = side === 'start' ? 'M9 3v18' : 'M15 3v18';
const closePoints = side === 'start' ? '16 9 13 12 16 15' : '8 9 11 12 8 15';
const openPoints = side === 'start' ? '13 9 16 12 13 15' : '11 9 8 12 11 15';
---
<div class:list={['rail-header', `rail-header-${side}`]}>
  <button
    type="button"
    class="rail-toggle"
    aria-expanded="true"
    aria-controls={toggle.controls}
    aria-label={toggle.label}
    {...dataAttribute}
  >
    <svg
      class="rail-toggle-icon"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <rect x="3" y="3" width="18" height="18" rx="2"></rect>
      <path d={dividerPath}></path>
      <polyline class="chevron-close" points={closePoints}></polyline>
      <polyline class="chevron-open" points={openPoints}></polyline>
    </svg>
  </button>
  <p class="rail-label">{label}</p>
</div>

<style>
  .rail-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2rem;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--space-4);
  }

  .rail-header-start { justify-content: space-between; }

  .rail-header-start .rail-toggle { order: 1; }

  .rail-label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--toc-label-color);
    margin: 0;
  }

  .rail-toggle-icon { display: block; }

  .chevron-open { display: none; }

  :global(html[data-nav-collapsed]) .rail-header-start .chevron-close,
  :global(html[data-toc-collapsed]) .rail-header-end .chevron-close { display: none; }

  :global(html[data-nav-collapsed]) .rail-header-start .chevron-open,
  :global(html[data-toc-collapsed]) .rail-header-end .chevron-open { display: block; }

  :global(html[data-nav-collapsed]) .rail-header-start,
  :global(html[data-toc-collapsed]) .rail-header-end {
    justify-content: center;
    padding-bottom: 0;
    border-bottom: 0;
    margin-bottom: 0;
  }

  :global(html[data-nav-collapsed]) .rail-header-start .rail-label,
  :global(html[data-toc-collapsed]) .rail-header-end .rail-label { display: none; }

  @media (min-width: 48.001rem) {
    .rail-header {
      position: sticky;
      top: 0;
      z-index: 1;
      background: var(--bg);
    }
  }

  @media (max-width: 48rem) {
    .rail-header-start { display: none; }
  }
</style>
