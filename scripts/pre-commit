#!/bin/bash
# Pre-commit hook for Carina
# Install: ./scripts/setup-hooks.sh
#
# Environment variables:
#   SKIP_CLIPPY=1  - Skip clippy check (useful for WIP commits)

changed_crates=()
fmt_scope=()
clippy_scope=()
check_mode=""

hook_static_checks=(
    check-error-source-not-in-display
    check-no-direct-resources-access
    check-cli-hints-use-project-command
    check-no-home-env-reads
    check-plan-fixtures
    check-provider-boundaries
    check-protocol-convert-exhaustive
    check-wit-guest-text-confinement
    check-schema-parts-exhaustive
    check-docs-use-new-spellings
    check-rust-cache-via-local-action
)

excluded_static_checks=(
    # Imports tomllib (Python 3.11+); macOS /usr/bin/python3 is 3.9,
    # so commits fail with a traceback unless a newer python3 is first on PATH.
    check-pinned-toolchain
    check-no-wall-clock-test-assertions # Full Rust source scan takes 37s, too slow for a hook.
    check-provider-sdk-bindings # Uses cargo metadata to resolve provider dependencies.
    check-test-utils-dev-only # Uses cargo tree to resolve workspace dependency features.
    check-crates-not-publishable # Uses cargo metadata to read effective publish settings.
    check-wit-bindgen-workspace # Uses cargo metadata to resolve workspace bindings.
    check-vendored-patches-used # Resolves dependencies with cargo metadata --locked.
    check-example-warnings # Builds the CLI with cargo build.
    check-provider-cause-test-api # Compiles downstream fixtures with cargo check.
)

run_static_checks() (
    local scripts_dir="${1:-scripts}"
    local log_dir
    local script
    local start
    local elapsed
    local check_exit
    local failed=0
    local i
    local pids=()

    log_dir=$(mktemp -d) || return 1
    trap 'rm -rf "$log_dir"' EXIT

    for script in "${hook_static_checks[@]}"; do
        (
            start=$(date +%s)
            check_exit=0
            bash "$scripts_dir/$script.sh" >"$log_dir/$script.log" 2>&1 || check_exit=$?
            echo "$(( $(date +%s) - start ))" >"$log_dir/$script.elapsed"
            exit "$check_exit"
        ) &
        pids+=("$!")
    done

    for ((i = 0; i < ${#hook_static_checks[@]}; i++)); do
        script="${hook_static_checks[$i]}"
        check_exit=0
        wait "${pids[$i]}" || check_exit=$?
        elapsed=$(cat "$log_dir/$script.elapsed")
        if [ "$check_exit" -ne 0 ]; then
            echo "$script FAILED (${elapsed}s):"
            cat "$log_dir/$script.log"
            echo
            echo "this static check also runs in CI; fix it now instead of spending a CI round"
            failed=1
        else
            echo "$script passed (${elapsed}s)"
        fi
    done

    return "$failed"
)

path_requires_workspace_rust_checks() {
    case "$1" in
        Cargo.toml | Cargo.lock | rust-toolchain | rust-toolchain.toml | rustfmt.toml | clippy.toml)
            return 0
            ;;
        .cargo/* | scripts/pre-commit | scripts/setup-hooks.sh)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

collect_changed_crates() {
    local staged_files="$1"
    local crate_name

    changed_crates=()
    for crate_dir in carina-*/; do
        crate_name="${crate_dir%/}"
        # Skip directories that are not Cargo crates (e.g., WIT-only packages)
        [ -f "${crate_dir}Cargo.toml" ] || continue
        if echo "$staged_files" | grep -q "^${crate_name}/"; then
            changed_crates+=("-p" "$crate_name")
        fi
    done
}

has_workspace_rust_changes() {
    local staged_files="$1"
    local staged_file

    while IFS= read -r staged_file; do
        [ -z "$staged_file" ] && continue
        if path_requires_workspace_rust_checks "$staged_file"; then
            return 0
        fi
    done <<<"$staged_files"

    return 1
}

set_check_scopes() {
    local staged_files="$1"

    collect_changed_crates "$staged_files"

    if has_workspace_rust_changes "$staged_files"; then
        check_mode="workspace"
        fmt_scope=(--all)
        clippy_scope=(--all-targets --all-features)
    elif [ ${#changed_crates[@]} -gt 0 ]; then
        check_mode="crate"
        fmt_scope=("${changed_crates[@]}")
        clippy_scope=("${changed_crates[@]}" --all-targets --all-features)
    else
        check_mode="skip"
        fmt_scope=()
        clippy_scope=()
    fi
}

main() {
    local current_branch
    local staged_files
    local static_exit
    local static_log
    local static_pid
    local fmt_log
    local clippy_log
    local fmt_start
    local fmt_pid
    local clippy_start
    local clippy_pid
    local fmt_exit
    local clippy_exit
    local fmt_end
    local fmt_elapsed
    local clippy_end
    local clippy_elapsed

    set -e

    # Block direct commits to main/master only when running the hook, so tests
    # can source its functions on main or a detached CI checkout.
    current_branch=$(git symbolic-ref --short HEAD 2>/dev/null) || current_branch=""
    if [ "$current_branch" = "main" ] || [ "$current_branch" = "master" ]; then
        echo "ERROR: Direct commits to '$current_branch' are not allowed."
        echo "Create a feature branch first: git worktree add .worktrees/<branch-name> -b <branch-name> main"
        exit 1
    fi

    echo "Running pre-commit checks..."

    staged_files=$(git diff --cached --name-only)
    # Commits that only delete files still need static checks.
    if [ -z "$staged_files" ] && git diff --cached --quiet; then
        echo "No staged files, skipping checks."
        exit 0
    fi

    static_exit=0
    set_check_scopes "$staged_files"
    if [ "$check_mode" = "skip" ]; then
        echo "No Rust-affecting changes detected, skipping Rust checks."
        run_static_checks || static_exit=$?
        exit "$static_exit"
    fi

    # sccache (configured via .cargo/config.toml) is incompatible with cargo's
    # incremental compilation. Always disable sccache and enable incremental
    # compilation for pre-commit checks. We unconditionally clear RUSTC_WRAPPER
    # because cargo resolves .cargo/config.toml from parent directories, so
    # sccache may be active even when no config exists in the current worktree.
    export CARGO_INCREMENTAL=1

    static_log=$(mktemp)
    fmt_log=$(mktemp)
    clippy_log=$(mktemp)
    # Capture paths while main's local variables are still in scope.
    trap "$(printf 'rm -f %q %q %q' "$static_log" "$fmt_log" "$clippy_log")" EXIT

    run_static_checks >"$static_log" 2>&1 &
    static_pid=$!

    fmt_start=$(date +%s)
    cargo fmt "${fmt_scope[@]}" -- --check >"$fmt_log" 2>&1 &
    fmt_pid=$!

    if [ "${SKIP_CLIPPY:-0}" = "1" ]; then
        echo "Skipping clippy (SKIP_CLIPPY=1)"
        clippy_pid=""
    else
        clippy_start=$(date +%s)
        RUSTC_WRAPPER="" cargo clippy "${clippy_scope[@]}" --no-deps -- -D warnings >"$clippy_log" 2>&1 &
        clippy_pid=$!
    fi

    fmt_exit=0
    clippy_exit=0
    wait $fmt_pid || fmt_exit=$?
    fmt_end=$(date +%s)
    fmt_elapsed=$((fmt_end - fmt_start))

    if [ -n "$clippy_pid" ]; then
        wait $clippy_pid || clippy_exit=$?
        clippy_end=$(date +%s)
        clippy_elapsed=$((clippy_end - clippy_start))
    fi

    wait "$static_pid" || static_exit=$?
    cat "$static_log"

    if [ $fmt_exit -ne 0 ]; then
        echo "Formatting check FAILED (${fmt_elapsed}s):"
        cat "$fmt_log"
        echo ""
    else
        echo "Formatting check passed (${fmt_elapsed}s)"
    fi

    if [ -n "$clippy_pid" ]; then
        if [ $clippy_exit -ne 0 ]; then
            echo "Clippy check FAILED (${clippy_elapsed}s):"
            cat "$clippy_log"
            echo ""
        else
            echo "Clippy check passed (${clippy_elapsed}s)"
        fi
    fi

    if [ $static_exit -ne 0 ] || [ $fmt_exit -ne 0 ] || [ $clippy_exit -ne 0 ]; then
        exit 1
    fi

    echo "All pre-commit checks passed!"
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
